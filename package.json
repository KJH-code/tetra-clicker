{
  "name": "tetra-clicker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:fast": "vitest run --exclude 'tests/slow/**'",
    "test:slow": "vitest run tests/slow",
    "build:engine": "sh scripts/build-engine.sh"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "tetris-fumen": "1.1.3"
  }
}
